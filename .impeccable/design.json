      "html": "<article class=\"ds-branch\" dir=\"rtl\"><h3><a href=\"/branches\">فرع المنصور</a></h3><p>بغداد — المنصور</p><div class=\"ds-branch-bottom\"><a href=\"/branches\">شوف الفرع <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"m12 19-7-7 7-7M5 12h14\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></a></div></article>",
