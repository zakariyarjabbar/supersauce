      "html": "<div class=\"ds-search\" dir=\"rtl\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"8\"/><path d=\"m21 21-4.3-4.3\"/></svg><input type=\"search\" aria-label=\"ابحث في المنيو\" placeholder=\"برغر، دجاج، فرايز... شنو ببالك؟\"></div>",
      "css": ".ds-search{font-family:var(--font-sans,\"Alexandria Variable\",sans-serif);display:flex;align-items:center;gap:12px;border:1px solid var(--line-strong,#ae887b);background:var(--surface,#fff9ee);border-radius:8px;min-height:52px;padding-inline:17px;color:var(--muted,#6d514e);max-width:580px}.ds-search:focus-within{border-color:var(--burgundy,#681e32);outline:2px solid var(--burgundy,#681e32);outline-offset:2px}.ds-search svg{flex-shrink:0}.ds-search input{font-family:var(--font-sans,\"Alexandria Variable\",sans-serif);border:0;background:none;outline:0;width:100%;min-width:0;font-size:13px;padding-block:12px;color:var(--ink,#29141a)}.ds-search input::placeholder{color:var(--muted,#6d514e);opacity:1}.ds-search input:focus-visible{outline:none}"
