# Keep true for the sales presentation. Set false only after content and operational details are approved.
NEXT_PUBLIC_DEMO_MODE=true
# Set the real canonical origin before a public launch.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Restaurant-approved phone and WhatsApp numbers, including country code (e.g. +964...).
# Empty or invalid values leave that option visibly unavailable; Instagram remains available.
NEXT_PUBLIC_ORDER_PHONE=
NEXT_PUBLIC_ORDER_WHATSAPP=
# Optional transactional delivery. All three values are required for live forms.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
