# Public origin used in share previews and canonical URLs. No trailing path.
NEXT_PUBLIC_SITE_URL=https://supersauce-rho.vercel.app
# Restaurant-approved phone and WhatsApp numbers, including country code (e.g. +964...).
# Empty or invalid values leave that option visibly unavailable; Instagram remains available.
NEXT_PUBLIC_ORDER_PHONE=
NEXT_PUBLIC_ORDER_WHATSAPP=
# Optional email delivery. All three values enable the contact and careers forms.
# Without them, those pages direct visitors to the restaurant's Instagram profile.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
